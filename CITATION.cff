    family-names: "Lee"
    affiliation: "Korea Gas Safety Corporation (KGS), AI Safety Research Team"
    orcid: "https://orcid.org/0009-0008-8976-5363"
version: "0.3.0"
license: MIT
identifiers:
  - type: doi
    value: "10.5281/zenodo.22162092"
    description: "Concept DOI resolving to the latest archived release"
keywords:
  - LPG
  - liquid hydrogen
  - fire safety
  - heat flux
  - pressure relief valve
  - ortho-para hydrogen
  - pathwise composition criterion
  - closed-vessel pressure-rise method
  - process safety
repository-code: "https://github.com/lyullee/pifira"
