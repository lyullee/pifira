include LICENSE
include README.md
include CITATION.cff
include CHANGELOG.md
include VALIDATION_SOURCES.md
recursive-include examples *.py
recursive-include tools *.py

prune data
prune validation-data
prune validation_data
prune literature_sources
global-exclude *.csv *.tsv *.xls *.xlsx *.xlsm
global-exclude *.pdf *.doc *.docx *.ppt *.pptx
global-exclude *.jpg *.jpeg *.png *.tif *.tiff *.bmp *.gif
global-exclude *.mts *.npz *.npy *.zip
